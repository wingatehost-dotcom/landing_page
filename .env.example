# Contact form — copy to `.env.local` and fill in before building.
#
# MODE
#   formsubmit (recommended) sends via FormSubmit.co, no account required.
#   endpoint   posts JSON to NEXT_PUBLIC_FORM_ENDPOINT.
#   mailto     opens the visitor's email app with a prefilled message.
NEXT_PUBLIC_FORM_MODE=formsubmit

# FormSubmit.co endpoint. Replace <address> with the inbox that should receive
# form submissions. After the first submission, FormSubmit emails a one-time
# activation link, then a random alias. Use
# https://formsubmit.co/ajax/<alias> here to keep the inbox out of the bundle.
NEXT_PUBLIC_FORMSUBMIT_ENDPOINT=https://formsubmit.co/ajax/<address>

# Used only when NEXT_PUBLIC_FORM_MODE=endpoint.
# Formspree:  https://formspree.io/f/xxxxxxxx
# PHP script: /api/contact.php
NEXT_PUBLIC_FORM_ENDPOINT=

# The PHP recipient is configured in public/api/contact.php (or via the
# CONTACT_TO_EMAIL environment variable on the server).
